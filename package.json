{
  "name": "lexdistill-monorepo",
  "version": "0.1.2",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "bun scripts/dev-run.ts",
    "dev:web:parallel": "bun --parallel --filter @lexdistill/web --filter @lexdistill/gateway dev",
    "dev:clean": "bun scripts/dev-clean.ts",
    "dev:gateway": "bun --filter @lexdistill/gateway dev",
    "dev:desktop": "bun scripts/dev-desktop.ts",
    "build": "bun --filter \"*\" build",
    "build:sidecar": "bun run --filter @lexdistill/gateway sidecar:build",
    "typecheck": "tsc -b --force",
    "test:all": "bun test --path-ignore-patterns \"**/dist/**\"",
    "test": "bun run test:all",
    "release:sync": "bun scripts/release.ts sync",
    "release:notes": "bun scripts/release.ts notes",
    "release": "bun scripts/release.ts publish"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^22.10.7",
    "typescript": "^5.7.3",
    "zod": "^3.24.1"
  }
}
