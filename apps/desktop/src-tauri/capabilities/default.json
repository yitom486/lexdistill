{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "LexDistill 桌面壳默认能力：平台命令 + opener/clipboard/dialog 插件权限。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "clipboard-manager:default",
    "dialog:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "lexdistill-gateway",
          "sidecar": true,
          "args": true
        }
      ]
    },
    "updater:default",
    "process:default"
  ]
}
