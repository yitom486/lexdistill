{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lingua Studio",
  "version": "0.1.2",
  "identifier": "com.studystudio.desktop",
  "build": {
    "beforeDevCommand": "bun run --filter @study-studio/gateway pdf:prepare && bun run --filter @study-studio/web dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun run build:sidecar && bun run --filter @study-studio/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lingua Studio - AI 外语学习系统",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/study-studio-gateway"
    ],
    "resources": {
      "resources/pdf-runtime/": "pdf-runtime/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY3MzZFRDUxQzhFNTU3RDkKUldUWlYrWElVZTAyWjNtMmliS3c0akkvVnhaQ2lXWXJvN0pXOXVJMFFCb1VKS2ZsUGxwTm5wclQK",
      "endpoints": [
        "https://github.com/yitom486/lingua-studio/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
