{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@study-studio/gateway": ["../gateway/src/index.ts"],
      "@study-studio/shared": ["../../packages/shared/src/index.ts"],
      "@study-studio/protocol": ["../../packages/protocol/src/index.ts"],
      "@study-studio/learner-core": ["../../packages/learner-core/src/index.ts"],
      "@study-studio/speech": ["../../packages/speech/src/index.ts"]
    }
  },
  "references": [
    { "path": "../../packages/shared" },
    { "path": "../../packages/protocol" },
    { "path": "../../packages/learner-core" },
    { "path": "../../packages/speech" },
    { "path": "../gateway" }
  ],
  "include": ["src"]
}
