{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@lexdistill/gateway": ["../gateway/src/index.ts"],
      "@lexdistill/shared": ["../../packages/shared/src/index.ts"],
      "@lexdistill/document-model": ["../../packages/document-model/src/index.ts"],
      "@lexdistill/protocol": ["../../packages/protocol/src/index.ts"],
      "@lexdistill/learner-core": ["../../packages/learner-core/src/index.ts"],
      "@lexdistill/speech": ["../../packages/speech/src/index.ts"],
      "@lexdistill/agent-runtime": ["../../packages/agent-runtime/src/index.ts"],
      "@lexdistill/learning": ["../../packages/learning/src/index.ts"]
    }
  },
  "references": [
    { "path": "../../packages/shared" },
    { "path": "../../packages/document-model" },
    { "path": "../../packages/protocol" },
    { "path": "../../packages/learner-core" },
    { "path": "../../packages/speech" },
    { "path": "../../packages/agent-runtime" },
    { "path": "../../packages/learning" },
    { "path": "../gateway" }
  ],
  "include": ["src"]
}
