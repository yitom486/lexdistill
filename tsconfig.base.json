{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["bun"],
    "baseUrl": ".",
    "paths": {
      "@lexdistill/shared": ["./packages/shared/src/index.ts"],
      "@lexdistill/protocol": ["./packages/protocol/src/index.ts"],
      "@lexdistill/learner-core": ["./packages/learner-core/src/index.ts"],
      "@lexdistill/tool-core": ["./packages/tool-core/src/index.ts"],
      "@lexdistill/agent-runtime": ["./packages/agent-runtime/src/index.ts"],
      "@lexdistill/speech": ["./packages/speech/src/index.ts"],
      "@lexdistill/learning-algorithms": ["./packages/learning-algorithms/src/index.ts"],
      "@lexdistill/flashcards": ["./packages/flashcards/src/index.ts"],
      "@lexdistill/ai-content": ["./packages/ai-content/src/index.ts"],
      "@lexdistill/content": ["./packages/content/src/index.ts"],
      "@lexdistill/document-model": ["./packages/document-model/src/index.ts"],
      "@lexdistill/lexicon": ["./packages/lexicon/src/index.ts"],
      "@lexdistill/learning": ["./packages/learning/src/index.ts"],
      "@lexdistill/storage-sqlite": ["./packages/storage-sqlite/src/index.ts"],
      "@lexdistill/archive": ["./packages/archive/src/index.ts"],
      "@lexdistill/gateway": ["./apps/gateway/src/index.ts"]
    }
  }
}
