{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["bun"],
    "baseUrl": ".",
    "paths": {
      "@study-studio/shared": ["./packages/shared/src/index.ts"],
      "@study-studio/protocol": ["./packages/protocol/src/index.ts"],
      "@study-studio/learner-core": ["./packages/learner-core/src/index.ts"],
      "@study-studio/agent-core": ["./packages/agent-core/src/index.ts"],
      "@study-studio/tool-core": ["./packages/tool-core/src/index.ts"],
      "@study-studio/tts-core": ["./packages/tts-core/src/index.ts"],
      "@study-studio/agent-codex": ["./packages/agent-codex/src/index.ts"],
      "@study-studio/agent-runtime": ["./packages/agent-runtime/src/index.ts"],
      "@study-studio/speech": ["./packages/speech/src/index.ts"],
      "@study-studio/learning-algorithms": ["./packages/learning-algorithms/src/index.ts"],
      "@study-studio/dictionary-core": ["./packages/dictionary-core/src/index.ts"],
      "@study-studio/dictionary-integrations": ["./packages/dictionary-integrations/src/index.ts"],
      "@study-studio/flashcard-integrations": ["./packages/flashcard-integrations/src/index.ts"],
      "@study-studio/flashcard-core": ["./packages/flashcard-core/src/index.ts"],
      "@study-studio/flashcards": ["./packages/flashcards/src/index.ts"],
      "@study-studio/ai-content": ["./packages/ai-content/src/index.ts"],
      "@study-studio/lexicon": ["./packages/lexicon/src/index.ts"],
      "@study-studio/review-core": ["./packages/review-core/src/index.ts"],
      "@study-studio/practice-core": ["./packages/practice-core/src/index.ts"],
      "@study-studio/learning": ["./packages/learning/src/index.ts"],
      "@study-studio/gateway": ["./apps/gateway/src/index.ts"]
    }
  }
}
